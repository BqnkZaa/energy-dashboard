# WebSocket Server URL ของ Raspberry Pi Backend
# เปลี่ยนเป็น IP จริงของ Raspberry Pi ในเครือข่าย
NEXT_PUBLIC_WS_URL=ws://192.168.1.100:8000/ws

# Vercel Blob แบบ Private สำหรับ WebSocket URL ส่วนกลาง
# เมื่อเชื่อม Blob store กับ Vercel Project ระบบจะเพิ่มค่านี้ให้อัตโนมัติ
BLOB_READ_WRITE_TOKEN=replace_with_your_blob_store_token

# รหัสผ่านสำหรับเปิดหน้า Settings บน Dashboard
# ห้ามใช้ NEXT_PUBLIC_ นำหน้า เพราะรหัสผ่านต้องอยู่ฝั่ง server เท่านั้น
# เมื่อ deploy บน Vercel ให้เพิ่มชื่อนี้ใน Settings > Environment Variables ด้วย
ADMIN_PASSWORD=change_this_to_a_strong_admin_password
